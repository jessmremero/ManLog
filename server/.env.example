PORT=3000
NODE_ENV=development

# MySQL（本地开发示例）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=manlog

# JWT
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN_SEC=7200

# 统计用「用户本地时区」口径（IANA），与 design.md 一致可改为用户维度后再扩展
DEFAULT_TZ=Asia/Shanghai

# 记录字段加密主密钥：64 位十六进制（32 字节）或 32 字节 Base64。生产环境必填。
# 生成示例：openssl rand -hex 32
MANLOG_RECORD_MASTER_KEY=
